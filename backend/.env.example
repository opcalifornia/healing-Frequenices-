# Copy to .env for local development.
ENVIRONMENT=development
MONGO_URL=mongodb://localhost:27017
# MONGO_URL=mongomock://local     # in-memory DB, no MongoDB needed (dev deps)
MONGO_DB=healing_frequencies
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
SEED_ON_STARTUP=true

# Stripe subscriptions (optional, see app/services/billing.py)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# APP_URL=https://your-app.vercel.app

# Cloudflare R2 media (optional, see app/services/storage.py)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=

# Behind a proxy/load balancer (Render, Railway): use X-Forwarded-For for rate limits.
# TRUST_PROXY=true
